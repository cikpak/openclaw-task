{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}
	@backend path /api/* /ws/* /health /ready
	handle @backend {
		reverse_proxy 127.0.0.1:3000 {
			# DigitalOcean terminates public TLS; the backend trusts this single proxy.
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
