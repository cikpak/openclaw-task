# Generate app secrets with: pnpm setup:env
APP_USERNAME=admin
# scrypt$<hex salt>$<hex derived key>; generator prompts for your password.
APP_PASSWORD_HASH=
# Exactly 64 hex characters (32 random bytes).
SESSION_KEY=
# Random Gateway shared token; never exposed to the frontend.
GATEWAY_TOKEN=
# Configure a provider before sending real messages.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Caddy binds only loopback by default. Set APP_SITE=your.domain for HTTPS deployment.
APP_SITE=http://localhost
APP_PORT=8080
APP_HTTPS_PORT=8443
APP_BIND_ADDRESS=127.0.0.1
APP_ORIGIN=http://localhost:8080
# true only for explicit loopback HTTP development.
ALLOW_INSECURE_LOOPBACK=true
DEFAULT_MODEL=anthropic/claude-sonnet-4-5
