# Generate .env with pnpm setup:env. Never commit it.
APP_USERNAME=admin
# scrypt$<hex salt>$<hex derived key>; setup prompts privately.
APP_PASSWORD_HASH=
DEFAULT_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ENGINE_IDLE_SECONDS=60
# pnpm dev assigns workspace-specific ports/state; optionally override them.
# FRONTEND_PORT=15100
# CLOUDFLARE_PORT=15101
# CLOUDFLARE_STATE_DIR=/absolute/workspace/local-state
